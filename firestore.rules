rules_version = '2';

// قواعد Firestore لموقع سياق (مشروع engle-e9877).
// - owners: مالك الموقع — يُضاف يدويًا من لوحة Firebase فقط (لا يكتبه أحد من الموقع).
// - teachers: المعلمون — كل معلم يفعّل حسابه برمز من المالك (teacherInvites). الرمز لشخص واحد،
//   ومدة الصلاحية يحددها المالك (days، و0 = بلا انتهاء) ويمكنه تمديدها. shareKey: يستخدم مفتاح Gemini المشترك.
// - config: إعدادات يشاركها المالك (قائمة الكلمات للجميع، والسماح للطلاب بالمفتاح).
// - secrets/gemini: مفتاح المالك المشترك — للمالك وللمعلمين المسموح لهم (وللطلاب إن سمح المالك).
// - wordContent: مكتبة شرح الكلمات المشتركة — يقرؤها كل مسجّل، ويكتبها من يملك مفتاحًا.
// - studentCodes: رموز دخول الطلاب — ينشئها المعلم باسم الطالب (وفصول اختيارية)، وأول حساب يدخلها يصبح صاحبها.
// - studentNotes: ملاحظات المعلم الخاصة عن الطالب — للمعلم والمالك فقط.
// - students: سجل الطالب المرتبط بمعلمه (والفصول وملخص التقدّم) — للطالب ومعلمه والمالك.
// - learners: بيانات كل متعلم الخاصة — صاحبها فقط.
// - classes: فصول المعلمين. الرمز هو معرّف الفصل (يُعطى للطلاب). للفصل معلم رئيسي ومعلمون مشاركون.
//   الطالب يرى واجبات فصله ونتيجته فقط؛ المعلم يرى طلاب فصوله ونتائجهم؛ المالك يرى كل شيء.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function teacherDoc() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }
    function isActiveTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && (teacherDoc().get('expiresAt', null) == null || teacherDoc().expiresAt > request.time);
    }
    // المعلم الفعّال (لم تنتهِ مدته) أو المالك.
    function isStaff() {
      return isOwner() || isActiveTeacher();
    }
    function studentsUseKey() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/ai)
        && get(/databases/$(database)/documents/config/ai).data.get('studentsUseKey', false) == true;
    }
    // من يحق له استخدام المفتاح المشترك.
    function mayUseSharedKey() {
      return isOwner() || (isActiveTeacher() && teacherDoc().get('shareKey', false) == true) || studentsUseKey();
    }
    // تفعيل برمز: الرمز غير مستخدم، ويُعلَّم في نفس الدفعة باسم هذا الحساب،
    // والمدة لا تتجاوز ما حدده المالك، وإذن المفتاح كما في الرمز.
    function inviteOk(data) {
      let inv = /databases/$(database)/documents/teacherInvites/$(data.invite);
      let days = get(inv).data.get('days', 0);
      return data.invite is string
        && get(inv).data.usedBy == null
        && getAfter(inv).data.usedBy == request.auth.uid
        && data.get('shareKey', false) == get(inv).data.get('shareKey', false)
        && (days == 0
          ? data.get('expiresAt', null) == null
          : (data.expiresAt is timestamp && data.expiresAt <= request.time + duration.value(days + 1, 'd')));
    }
    // ربط الطالب برمز: الرمز غير مستخدم، ويُعلَّم في نفس الدفعة باسم هذا الحساب، والمعلم هو صاحب الرمز.
    function studentCodeOk(data) {
      let c = /databases/$(database)/documents/studentCodes/$(data.code);
      return data.code is string
        && get(c).data.usedBy == null
        && getAfter(c).data.usedBy == request.auth.uid
        && data.teacherUid == get(c).data.teacherUid;
    }
    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40;
    }

    match /owners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow get: if signedIn();
      allow write: if isOwner();
    }

    match /secrets/{doc} {
      allow get: if mayUseSharedKey();
      allow write: if isOwner();
    }

    match /wordContent/{id} {
      allow read: if signedIn();
      allow create, update: if (isStaff() || studentsUseKey())
        && request.resource.data.keys().hasOnly(['content', 'topic', 'model', 'createdAt'])
        && request.resource.data.content is map;
      allow delete: if isOwner();
    }

    // رموز المعلمين: المالك يُنشئها ويراها كلها؛ من يعرف الرمز يقرؤه، وأول حساب يستخدمه يصبح صاحبه.
    match /teacherInvites/{code} {
      allow get: if signedIn();
      allow list, delete: if isOwner();
      allow create: if isOwner() && request.resource.data.usedBy == null
        && request.resource.data.days is int && request.resource.data.days >= 0 && request.resource.data.days <= 3660;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedName', 'usedAt'])
        && getAfter(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.invite == code;
    }

    match /teachers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list, delete: if isOwner();
      // التفعيل (أو التجديد برمز جديد بعد انتهاء المدة).
      allow create: if signedIn() && request.auth.uid == uid && validName(request.resource.data)
        && (isOwner() || inviteOk(request.resource.data));
      // المعلم يغيّر اسمه فقط أو يجدد برمز جديد؛ المالك يمدد المدة ويغيّر إذن المفتاح.
      allow update: if isOwner() || (signedIn() && request.auth.uid == uid && validName(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) || inviteOk(request.resource.data)));
    }

    match /studentCodes/{code} {
      allow get: if signedIn();
      allow list: if isOwner() || (signedIn() && resource.data.teacherUid == request.auth.uid);
      allow create: if (isOwner() || (isStaff() && request.resource.data.teacherUid == request.auth.uid))
        && request.resource.data.usedBy == null && validName(request.resource.data);
      // المعلم يعدّل الاسم والفصول؛ الطالب يربط الرمز بحسابه مرة واحدة.
      allow update: if isOwner()
        || (isStaff() && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == resource.data.teacherUid
          && request.resource.data.usedBy == resource.data.usedBy)
        || (signedIn() && resource.data.usedBy == null
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && getAfter(/databases/$(database)/documents/students/$(request.auth.uid)).data.code == code);
      allow delete: if isOwner() || (isStaff() && resource.data.teacherUid == request.auth.uid);
    }

    match /studentNotes/{code} {
      allow read, write: if isOwner()
        || (isStaff() && get(/databases/$(database)/documents/studentCodes/$(code)).data.teacherUid == request.auth.uid);
    }

    match /students/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner()
        || (isStaff() && resource.data.teacherUid == request.auth.uid));
      allow list: if isOwner() || (isStaff() && resource.data.teacherUid == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == uid && validName(request.resource.data)
        && studentCodeOk(request.resource.data);
      // الطالب: اسمه وملخص تقدّمه وفصوله، أو الارتباط بمعلم آخر برمز جديد.
      // معلمه: الاسم والفصول فقط. المالك: كل شيء.
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastSeen', 'known', 'learning', 'streak', 'classes'])
          || studentCodeOk(request.resource.data)))
        || (isStaff() && resource.data.teacherUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'classes']));
      allow delete: if isOwner() || (isStaff() && resource.data.teacherUid == request.auth.uid);
    }

    match /learners/{uid}/state/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /classes/{code} {
      function classDoc() {
        return get(/databases/$(database)/documents/classes/$(code)).data;
      }
      // المعلم الرئيسي أو مشارك (ما دامت صلاحيته قائمة) أو المالك.
      function isTeacher() {
        return isOwner() || (isActiveTeacher()
          && (classDoc().teacherUid == request.auth.uid || request.auth.uid in classDoc().get('teachers', [])));
      }
      function isMainTeacher() {
        return isOwner() || (isActiveTeacher() && classDoc().teacherUid == request.auth.uid);
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid));
      }

      // من يعرف الرمز يقرأ اسم الفصل لينضم. القائمة: المعلم يرى فصوله (رئيسيًا أو مشاركًا)، والمالك يرى كل الفصول.
      allow get: if signedIn();
      allow list: if isOwner() || (signedIn()
        && (resource.data.teacherUid == request.auth.uid || request.auth.uid in resource.data.get('teachers', [])));
      // المعلم ينشئ فصوله، والمالك ينشئ فصلًا لأي معلم.
      allow create: if (isOwner() || (isStaff() && request.resource.data.teacherUid == request.auth.uid))
        && request.resource.data.get('teachers', []).size() == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      // نقل الفصل وتعيين المشاركين للمالك فقط.
      allow update: if isOwner() || (isTeacher()
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.get('teachers', []) == resource.data.get('teachers', []));
      allow delete: if isMainTeacher();

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        // ينضم الطالب بنفسه برمز الفصل، أو يضيفه المعلم من قائمة طلابه.
        allow create: if (signedIn() && request.auth.uid == uid || isTeacher())
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        allow delete: if signedIn() && (request.auth.uid == uid || isTeacher());
      }

      // إعلانات الفصل: يكتبها المعلم ويقرؤها طلابه.
      match /announcements/{id} {
        allow read: if isTeacher() || isMember();
        allow create: if isTeacher() && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if isTeacher();
      }

      match /assignments/{aid} {
        function assignment() {
          return get(/databases/$(database)/documents/classes/$(code)/assignments/$(aid)).data;
        }
        function forMe() {
          return assignment().get('to', []).size() == 0 || request.auth.uid in assignment().get('to', []);
        }
        // عدد المحاولات: يزيد واحدًا في كل حل، ولا يتجاوز الحد إن وُجد.
        function attemptOk(prev) {
          let max = assignment().get('maxAttempts', 0);
          return request.resource.data.attempts == prev + 1 && (max == 0 || request.resource.data.attempts <= max);
        }

        allow read: if isTeacher() || isMember();
        allow create, update, delete: if isTeacher();

        match /results/{uid} {
          allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
          allow create: if isMember() && request.auth.uid == uid && forMe() && attemptOk(0);
          allow update: if isMember() && request.auth.uid == uid && forMe() && attemptOk(resource.data.get('attempts', 0));
          allow delete: if isTeacher();
        }
      }
    }
  }
}
